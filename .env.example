# PostgreSQL connection string. Example for a local PostgreSQL database:
POSTGRES_USER="cafe_pos"
POSTGRES_PASSWORD="change-me-local-only"
POSTGRES_DB="cafe_pos"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://cafe_pos:change-me-local-only@localhost:5432/cafe_pos?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Local UI preview only. Never enables authentication bypass in production.
LOCAL_PREVIEW="false"
